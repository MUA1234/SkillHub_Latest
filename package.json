{
  "name": "skillhub-platform",
  "private": true,
  "version": "1.0.0",
  "description": "SkillHub Platform - Next.js Frontend & Database Setup",
  "main": "database_connection.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "node setup_supabase_database.js",
    "setup:reset": "node setup_supabase_database.js --reset",
    "test:connection": "node -e \"require('./database_connection').testConnection().then(() => process.exit(0)).catch(() => process.exit(1))\"",
    "migrate": "node setup_supabase_database.js",
    "seed": "node -e \"require('./setup_supabase_database.js')\"",
    "psql": "psql $DATABASE_URL",
    "production:build": "NODE_ENV=production npm run build",
    "production:start": "NODE_ENV=production npm start",
    "generate:secret": "node generate-secret.js",
    "railway:deploy": "railway deploy",
    "railway:logs": "railway logs",
    "lighthouse": "lhci autorun",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "keywords": [
    "skillhub",
    "postgresql",
    "supabase",
    "education",
    "platform",
    "nextjs",
    "fastapi"
